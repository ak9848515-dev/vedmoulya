# ─────────────────────────────────────────────────────────────────────────────
# VedMoulya — Web App Environment (example)
# MOB-001 — Mobile Authentication
# Copy to `.env.local` (web dev) or bake into the build (mobile static export).
# ─────────────────────────────────────────────────────────────────────────────

# tRPC gateway URL. Web: leave unset (same-origin `/api/trpc`). Mobile static
# export (Capacitor): set to the deployed server, e.g. https://api.example.com
# NEXT_PUBLIC_GATEWAY_URL=

# Identity Service REST API base URL. Web: leave unset (same origin — the
# Next.js app mounts the auth routes at /api/v1/identity/auth). Mobile: set to
# the deployed server, e.g. https://api.example.com
# NEXT_PUBLIC_IDENTITY_URL=

# Google OAuth redirect URI — MUST match the identity service's
# GOOGLE_REDIRECT_URI and the redirect URI registered in the Google Cloud
# Console for the OAuth client. Leave unset to default to
# <origin>/oauth2redirect (https://localhost/oauth2redirect inside the
# Capacitor WebView).
# NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# Set true to enable mock/dev shortcuts (future) — not implemented yet.
# NEXT_PUBLIC_AUTH_MOCK=false
