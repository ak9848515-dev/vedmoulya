{
  "name": "@vedmoulya/brain",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vedmoulya/ai": "*",
    "@vedmoulya/capability-marketplace": "*",
    "@vedmoulya/core": "*",
    "@vedmoulya/execution-bridge": "*",
    "@vedmoulya/loop-engine": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  }
}
