{
  "name": "@vedmoulya/mission-runtime",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "description": "BLD-022 — Autonomous Mission Runtime: the production composition layer that makes the BLD-021A Mission Controller executable against the real VedMoulya runtime (real planning, real agent execution, real AI providers, real ToolRuntime, real persistence). Composes ONLY existing frozen systems — duplicates nothing.",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vedmoulya/agent-execution": "*",
    "@vedmoulya/ai": "*",
    "@vedmoulya/core": "*",
    "@vedmoulya/execution-memory": "*",
    "@vedmoulya/experience-optimization": "*",
    "@vedmoulya/mission-controller": "*",
    "@vedmoulya/planning": "*",
    "@vedmoulya/providers": "*",
    "@vedmoulya/services": "*",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@vedmoulya/orchestrator": "*",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
