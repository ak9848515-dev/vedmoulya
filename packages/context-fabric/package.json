{
  "name": "@vedmoulya/context-fabric",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vedmoulya/capabilities": "*",
    "@vedmoulya/context": "*",
    "@vedmoulya/core": "*",
    "@vedmoulya/goals": "*",
    "@vedmoulya/knowledge-intelligence": "*",
    "@vedmoulya/memory-intelligence": "*"
  },
  "devDependencies": {
    "postgres": "^3.4.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
