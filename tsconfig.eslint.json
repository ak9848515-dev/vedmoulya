{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "*.config.js",
    "*.config.mjs",
    "vitest.workspace.ts",
    "tests/vitest.setup.ts",
    "packages/*/vitest.config.ts",
    "services/*/vitest.config.ts",
    "tooling/eslint-config/index.js"
  ]
}
