{
  "name": "vedmoulya",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "VedMoulya — The Execution Operating System. Empower every determined individual to build a sustainable livelihood through knowledge, execution, and intelligent technology.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w packages/core",
    "clean": "npm run clean --workspaces --if-present",
    "clean:build": "rm -rf apps/web/.next && echo 'Build cache cleared'",
    "dev": "npm run dev -w apps/web",
    "preflight": "npx tsx scripts/preflight.ts",
    "preflight:prod": "npx tsx scripts/preflight.ts --mode production",
    "doctor": "npx tsx scripts/doctor.ts",
    "doctor:prod": "npx tsx scripts/doctor.ts --mode production",
    "verify": "bash scripts/verify.sh",
    "check-port": "npx tsx scripts/check-port.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\"",
    "typecheck": "tsc -b && tsc --noEmit -p services/api",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "test:e2e": "cd apps/web && npx playwright test",
    "test:a11y": "bash scripts/run-a11y.sh",
    "test:performance": "bash scripts/check-bundle-size.sh",
    "audit": "npm audit --audit-level=critical",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run benchmarks && npm run audit",
    "quality:all": "npm run quality && npm run format",
    "prepare": "husky",
    "commit": "cz",
    "pr:create": "gh pr create --fill",
    "clean:all": "npm run clean && rm -rf node_modules",
    "reset": "npm run clean:all && npm install && npm run build:core",
    "bootstrap": "npm install && npm run build:core",
    "seed:ei": "npx tsx scripts/seed-ei.ts",
    "ai:smoke": "npx tsx scripts/ai-smoke.ts",
    "ai:smoke:live": "npx tsx scripts/ai-live-smoke.ts",
    "rag:eval": "npx tsx scripts/rag-evaluate.ts",
    "ai:benchmark": "npx tsx scripts/token-benchmark.ts",
    "outdated": "npm outdated",
    "update:deps": "npm update",
    "ci": "npm ci",
    "rag:pg:verify": "npx tsx scripts/rag-live-verify.ts",
    "rag:calibrate": "npx tsx scripts/rag-calibrate.ts",
    "provider:calibrate": "npx tsx scripts/provider-calibrate.ts",
    "accuracy:evaluate": "npx tsx scripts/accuracy-evaluate.ts",
    "matrix:realworld": "npx tsx scripts/realworld-matrix.ts",
    "loop:benchmark": "npx tsx scripts/loop-benchmark.ts",
    "factory:benchmark": "npx tsx scripts/app-factory-benchmark.ts",
    "requirements:benchmark": "npx tsx scripts/requirements-benchmark.ts",
    "experience:benchmark": "npx tsx scripts/experience-benchmark.ts",
    "execution:benchmark": "npx tsx scripts/execution-benchmark.ts",
    "brain:benchmark": "npx tsx scripts/brain-benchmark.ts",
    "intelligence:benchmark": "npx tsx scripts/intelligence-benchmark.ts",
    "bridge:benchmark": "npx tsx scripts/live-intelligence-bridge-benchmark.ts",
    "ai-world:scheduler:benchmark": "npx tsx scripts/ai-world-scheduler-benchmark.ts",
    "continuous:intelligence:benchmark": "npx tsx scripts/continuous-intelligence-benchmark.ts",
    "outcome:intelligence:benchmark": "npx tsx scripts/outcome-intelligence-benchmark.ts",
    "outcome:journey:benchmark": "npx tsx scripts/outcome-journey-benchmark.ts",
    "runtime:verification:benchmark": "npx tsx scripts/runtime-verification-benchmark.ts",
    "learning:benchmark": "npx tsx scripts/learning-benchmark.ts",
    "benchmarks": "npm run experience:benchmark && npm run factory:benchmark && npm run loop:benchmark && npm run requirements:benchmark && npm run execution:benchmark && npm run brain:benchmark && npm run intelligence:benchmark && npm run bridge:benchmark && npm run ai-world:scheduler:benchmark && npm run continuous:intelligence:benchmark && npm run outcome:intelligence:benchmark && npm run outcome:journey:benchmark && npm run runtime:verification:benchmark && npm run learning:benchmark && npm run production:benchmark && npm run quality:gates:verify",
    "ai:production:verify": "npx tsx scripts/ai-production-verify.ts",
    "ai:critique:verify": "npx tsx scripts/ai-critique-verify.ts",
    "production:benchmark": "npx tsx scripts/production-benchmark.ts",
    "quality:gates:verify": "npx tsx scripts/quality-gates-verify.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "commitizen": "^4.0.0",
    "cz-conventional-changelog": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.25",
    "uuid": "^11.1.1",
    "sharp": "^0.35.0",
    "fast-uri": "^3.1.5",
    "vite": "6.4.3"
  }
}
