# ──────────────────────────────────────────────────────────────────
# VedMoulya — Environment Configuration Template
# Copy to .env.local and fill in values
# ──────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=vedmoulya
APP_VERSION=1.0.0

# API Gateway
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# All service DATABASE_URLs are REQUIRED (no localhost default) outside
# NODE_ENV=development — fail-fast (PH-001/T2).
IDENTITY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vedmoulya_identity
KNOWLEDGE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vedmoulya_knowledge
DECISION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vedmoulya_decision
EXECUTION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vedmoulya_execution
MEMORY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vedmoulya_memory

# Redis
# REDIS_URL is REQUIRED (no localhost default) outside NODE_ENV=development.
REDIS_URL=redis://localhost:6379

# AI Providers
# The key for AI_DEFAULT_PROVIDER is REQUIRED in NODE_ENV=production when the AI
# assistant is enabled (default) — fail-fast (PH-001/T2):
#   AI_DEFAULT_PROVIDER=openai   → AI_OPENAI_API_KEY (default)
#   AI_DEFAULT_PROVIDER=deepseek → AI_DEEPSEEK_API_KEY
# The key for AI_DEFAULT_PROVIDER must be a real key (>= 32 chars, no placeholder).
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_GOOGLE_API_KEY=      # Google AI Studio API key (https://aistudio.google.com/apikey)
                        # SEPARATE from Google OAuth — Google login ≠ Gemini authorization.
                        # Server-side only; never exposed to the browser.
AI_DEEPSEEK_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_ROUTING_STRATEGY=capability

# Email verification delivery (SPRINT-045 — REQUIRED in production)
# EMAIL_DELIVERY_MODE: log | smtp
#   log  → the verification link is written to the application log. Development
#          default; in production ONLY for local certification (explicit escape,
#          never a silent fallback).
#   smtp → real delivery via SMTP (production default). Production FAILS FAST
#          when the required SMTP config is absent — verification is never
#          silently skipped. SMTP_USER/SMTP_PASS optional (open relays /
#          service accounts); EMAIL_FROM is REQUIRED.
# EMAIL_DELIVERY_MODE=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="VedMoulya <no-reply@example.com>"   (SMTP_FROM accepted as an alias)
# EMAIL_FROM_NAME=VedMoulya
# APP_URL=https://app.vedmoulya.com   ← the public base URL used in verification links

# Google OAuth (required in production only when FF_SOCIAL_LOGIN_ENABLED=true)
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are REQUIRED then; the redirect URI
# must not point at localhost (PH-001/T2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/identity/auth/google/callback

# Authentication
# AUTH_JWT_SECRET is REQUIRED (no default, fail-fast — P1-8). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=7d
AUTH_BCRYPT_ROUNDS=12

# Feature Flags
FF_SOCIAL_LOGIN_ENABLED=false
FF_AI_ASSISTANT_ENABLED=true
FF_MARKETPLACE_ENABLED=false

# Observability
OTEL_SERVICE_NAME=vedmoulya
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# API Gateway Rate Limiting (SPRINT-027 — async RateLimiter port)
# Default backend is per-process in-memory (honest `distributed:false` — the
# correct choice for a single gateway instance). For MULTI-INSTANCE deployments
# set RATE_LIMIT_BACKEND=redis + REDIS_URL (INCR+PEXPIRE fixed window; a Redis
# outage degrades loudly ONCE to bounded per-process buckets — distributed
# safety is never silently claimed; RATE_LIMIT_BACKEND=redis without REDIS_URL
# fails fast as a config error).
# RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_STANDARD_MAX=100
# RATE_LIMIT_STANDARD_WINDOW_MS=60000
# RATE_LIMIT_HEAVY_MAX=20
# RATE_LIMIT_HEAVY_WINDOW_MS=60000
# RATE_LIMIT_SEARCH_MAX=30
# RATE_LIMIT_SEARCH_WINDOW_MS=60000
# RATE_LIMIT_HEALTH_MAX=200
# RATE_LIMIT_HEALTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000

# Voice / speech foundation (SPRINT-027/028 — packages/voice)
# Real STT/TTS adapters are OPERATOR-CONFIGURED via the runtime adapters below
# (provider-neutral OpenAI-compatible audio endpoints; credentials stay
# server-side — never exposed to the browser). Until then voice.status reports
# MOCK, never CONFIGURED. Production REFUSES the mock adapters unless
# VOICE_ENABLE_MOCK=true (mirrors AI_ENABLE_MOCK — only for non-production-like
# environments):
# VOICE_ENABLE_MOCK=false
#
# Real STT (Speech-to-Text) — RuntimeSpeechToTextAdapter:
# VOICE_STT_BASE_URL=https://api.openai.com/v1
# VOICE_STT_MODEL=whisper-1
# VOICE_STT_API_KEY=
#
# Real TTS (Text-to-Speech) — RuntimeTextToSpeechAdapter:
# VOICE_TTS_BASE_URL=https://api.openai.com/v1
# VOICE_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS_VOICE=alloy
# VOICE_TTS_FORMAT=audio/mpeg
# VOICE_TTS_API_KEY=

# AI mock provider discipline (AI-RUNTIME-001/002)
# Production never serves synthetic responses: the deterministic MockProvider
# is only registered in non-production environments unless explicitly allowed:
# AI_ENABLE_MOCK=false

# Capability Execution hard limits (EPIC-014 — LoopBudget-backed RunBudgetGuard)
# Env-tunable; fail-closed — a budget breach BLOCKS the run, never silently exceeded.
# AI_EXECUTION_MAX_ITERATIONS=50
# AI_EXECUTION_MAX_TOKENS=100000
# AI_EXECUTION_MAX_COST_USD=5
# AI_EXECUTION_MAX_LATENCY_MS=600000


# AI World Discovery cadence (EPIC-018 runtime closure)
# The runtime cadence driver gives scheduler.tick() a real caller so 6-hour /
# daily / weekly discovery runs automatically for registered users. It reuses
# the os-health-scheduler pattern (singleton, unref'd, no overlapping ticks,
# fail-closed). Exactly ONE process must run it (single Next.js instance; with
# multiple replicas set AI_WORLD_CADENCE_ENABLED=0 on all but one until
# scheduler persistence + a distributed lock exist - documented operator step).
AI_WORLD_CADENCE_ENABLED=true
AI_WORLD_CADENCE_INTERVAL_MS=600000
# AI_WORLD_CADENCE_REFRESH_INTELLIGENCE (EPIC-021): on the same heartbeat the
# cadence driver also refreshes the Brain's discoverIntelligence per user
# (AI World events -> opportunities) and emits NEW_OPPORTUNITY notifications
# through the existing EPIC-015 notification store. 0 disables the refresh.
# Any false-y spelling disables the cadence family flags: 0, false, no, off
# (case-insensitive) — e.g. AI_WORLD_CADENCE_ENABLED=false disables the driver.
AI_WORLD_CADENCE_REFRESH_INTELLIGENCE=true
