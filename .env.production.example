[TEMPLATE]
# ──────────────────────────────────────────────────────────────────
# VedMoulya — Production Environment Template
# Copy to .env.production (or inject via secrets manager) and fill in.
# PH-001/T2: required secrets fail fast in NODE_ENV=production.
# PH-002 — Enterprise Operations & Reliability (T8 Deployment)
# ──────────────────────────────────────────────────────────────────

# Application
NODE_ENV=production
LOG_LEVEL=info
APP_NAME=vedmoulya
APP_VERSION=1.0.0
# Build metadata (injected at build time by CI)
GIT_SHA=REPLACE_AT_BUILD
BUILD_TIMESTAMP=REPLACE_AT_BUILD

# API Gateway
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=https://yourdomain.com

# Database (PostgreSQL) — all REQUIRED, non-localhost (PH-001/T2)
IDENTITY_DATABASE_URL=postgres://user:pass@db.internal:5432/vedmoulya_identity
KNOWLEDGE_DATABASE_URL=postgres://user:pass@db.internal:5432/vedmoulya_knowledge
DECISION_DATABASE_URL=postgres://user:pass@db.internal:5432/vedmoulya_decision
EXECUTION_DATABASE_URL=postgres://user:pass@db.internal:5432/vedmoulya_execution
MEMORY_DATABASE_URL=postgres://user:pass@db.internal:5432/vedmoulya_memory

# Redis — REQUIRED, non-localhost
REDIS_URL=redis://user:pass@redis.internal:6379

# AI Providers — default provider key REQUIRED (PH-001/T2)
# Note: `your-api-key` is a placeholder and WILL be rejected at startup
# in production (fail-fast). Replace with a real key (>= 32 chars).
AI_OPENAI_API_KEY=your-api-key
AI_ANTHROPIC_API_KEY=
AI_GOOGLE_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_ROUTING_STRATEGY=capability
# The Vercel AI SDK path is the primary production execution path. The raw-
# fetch adapter is an operator escape hatch — NEVER enable it in production
# unless pinned to the pre-SDK adapter.
AI_RUNTIME_LEGACY_RAW_FETCH=false
# Production must NEVER silently serve the deterministic mock provider. Only
# set AI_ENABLE_MOCK=true when running the platform without real providers
# (e.g. a non-production-like staging environment).
AI_ENABLE_MOCK=false

# AI Runtime tuning (AI-RUNTIME-002 C-07) — validated fail-fast by the
# gateway's validateProductionAIConfig in production/staging:
#   - AI_MAX_INPUT_TOKENS: hard input-token budget (pre-provider guard).
#   - AI_MAX_OUTPUT_TOKENS: output bound applied to every request.
#   - AI_PROVIDER_TIMEOUT_MS: bounded provider execution (default 60000).
#   - AI_TOOL_ALLOWLIST: explicit secure-tool allowlist (empty policy =
#     tools disabled by default; list safe tools to enable them).
#   - AI_PROMPT_CACHE_ENABLED: stable-prefix prompt cache (default true).
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_PROVIDER_TIMEOUT_MS=60000
AI_TOOL_ALLOWLIST=echo,current_time,calculator
AI_PROMPT_CACHE_ENABLED=true

# SMTP (only when email sending is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (only when FF_SOCIAL_LOGIN_ENABLED=true)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/identity/auth/google/callback

# Authentication
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=change-me-0123456789abcdef0123456789abcdef0123456789abcdef

# Feature Flags
FF_SOCIAL_LOGIN_ENABLED=false
FF_AI_ASSISTANT_ENABLED=true
FF_MARKETPLACE_ENABLED=false

# Observability (PH-002/T1) — OTLP collector endpoint
OTEL_SERVICE_NAME=vedmoulya
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Error reporting webhook (optional, PH-002/T1)
ERROR_REPORTING_ENDPOINT=

# AI World Discovery cadence (EPIC-018 runtime closure)
# Runs the discovery cadence driver in the gateway process. Keep enabled on
# EXACTLY ONE instance when running multiple replicas (until scheduler
# persistence + a distributed lock are in place).
AI_WORLD_CADENCE_ENABLED=true
AI_WORLD_CADENCE_INTERVAL_MS=600000
# AI_WORLD_CADENCE_REFRESH_INTELLIGENCE (EPIC-021): on the same heartbeat the
# cadence driver also refreshes the Brain's discoverIntelligence per user
# (AI World events -> opportunities) and emits NEW_OPPORTUNITY notifications
# through the existing EPIC-015 notification store. 0 disables the refresh.
AI_WORLD_CADENCE_REFRESH_INTELLIGENCE=true
